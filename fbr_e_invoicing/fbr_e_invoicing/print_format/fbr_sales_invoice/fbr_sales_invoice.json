 "css": ".print-format td, .print-format th {\n    padding: 2px !important;\n}\n.print-format td img {\n    max-width: 100px !important;\n    height:100px !important;\n}\n.print-format th {\n    border:1;\n    font-weight: normal;\n    color:black;\n    \n}\ntable {\n    font-size:12px;\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<html>\n<head>\n<style>\n.print-format td, .print-format th {\n    padding: 2px !important;\n}\n.print-format td img {\n    max-width: 100px !important;\n    height: 100px !important;\n}\n.print-format th {\n    border: 1;\n    font-weight: normal;\n    color: black;\n}\ntable {\n    font-size: 12px;\n}\n</style>\n</head>\n<body>\n    <table width=\"100%\">\n        <tr>\n            <td>\n                <table width=\"100%\">\n                    <tbody>\n                        <tr>   \n                            <td style=\"margin-left: 20px;\">\n                                <p style=\"text-align: center; font-size: 28px; text-decoration: underline;\">\n                                    <b style=\"\">SALES TAX INVOICE</b>\n                                </p>\n                            </td>\n                        </tr>\n                    </tbody>\n                </table>\n            </td>\n        </tr>\n        <tr>\n            <td>\n                <table width=\"100%\">\n                    <tr>\n                        <td>\n                            <table width=\"100%\">\n                                <tr>\n                                    <td width=\"25%\">\n                                        <p>Invoice No : {{ doc.name or \"\"}}</p>\n                                    </td>\n                                    <td width=\"25%\"> \n                                        <p style=\"float:right\">Invoice Date: {{ doc.get_formatted(\"posting_date\") or \"\" }}</p>\n                                    </td>\n                                </tr>\n                            </table>\n                        </td>\n                    </tr>\n                </table>\n                <table width=\"100%\" border=\"1\">\n                    <tr>\n                        <td width=\"20%\">\n                            <p>Buyer's Name & Address</p>\n                        </td>\n                        <td>\n                            <p><b>{{ doc.customer_name or \"\" }}</b></p>\n                            <p><b style=\"font-size:11px\">\n                                {% set customer_address = frappe.db.get_value(\"Address\", [\n                                    [\"Dynamic Link\", \"link_doctype\", \"=\", \"Customer\"],\n                                    [\"Dynamic Link\", \"link_name\", \"=\", doc.customer]], [\"address_line1\",\"city\",\"country\"], as_dict=1) %}\n                                {% if customer_address %}\n                                    {{ customer_address.address_line1 or \"\" }}{% if customer_address.address_line1 %},{% endif %}{{ customer_address.city or \"\" }}{% if customer_address.city %},{% endif %}{{ customer_address.country or \"\" }}\n                                {% endif %}\n                            </b></p>\n                        </td>\n                    </tr>\n                </table>\n                <table width=\"100%\"  border=\"1\" >\n                    <tr>\n                        <td width=\"10%\" style=\"text-align:center\">\n                            <p>STR No.</p>\n                        </td>\n                        <td width=\"20%\">\n                            <p></p>\n                        </td>\n                        <td width=\"10%\" style=\"text-align:center\">\n                            <p>NTN No.</p>\n                        </td>\n                        <td width=\"20%\">\n                            <p></p>\n                        </td>\n                        <td width=\"10%\" style=\"text-align:center\">\n                            <p>CNIC No.</p>\n                        </td>\n                        <td width=\"20%\" style=\"text-align:center\">\n                            <p></p>\n                        </td>\n                    </tr>\n                </table>\n                <br>\n                <table border=\"1\" style=\"font-size:11px;width:100%\">\n                    <thead>\n                        <tr style=\"color:black;\">\n                            <th style=\"text-align:center; width:10%;\"><br><br>Quantity</th>\n                            <th style=\"text-align:center; width:30%;\"><br><br>Description</th>\n                            <th style=\"text-align:center; width:10%;\"><br><br>Price</th>\n                            <th style=\"text-align:center;\">Value Excluding Sales Tax/Sales Tax on Services</th>\n                            <th style=\"text-align:center;width:12%\"><br><br>Rate of Sales Tax</th>\n                            <th style=\"text-align:center;\"><br>Amount of Sales Tax/Sales Tax on Services</th>\n                            <th style=\"text-align:center;\"><br>Value Including Sales Tax + Sales Tax on Services</th>\n                        </tr>\n                    </thead>\n                    \n                    <tbody>\n                        <tr style=\"background-color:#bebebe;text-align:center;color:white;height:15px\" >\n                            <td style=\"border-right:hidden\"></td>\n                            <td style=\"border-right:hidden\"></td>\n                            <td style=\"border-right:hidden\"></td>\n                            <td style=\"border-right:hidden\"></td>\n                            <td style=\"border-right:hidden\"></td>\n                            <td style=\"border-right:hidden\"></td>\n                            <td></td>\n                        </tr>\n                        \n                        {% set count={'total':0} %}\n                        {% for item in doc.items %}\n                        <tr style=\"font-size: 10px\">\n                            <td style=\"text-align: center; width: 10%;\"><b>{{ item.qty or \"\" }}</b></td>\n                            <td style=\"text-align: left; width: 30%;\"><b>{{ item.description or \"\" }}</b></td>\n                            <td style=\"text-align: center;\"><b>{{ \"{:,.0f}\".format(item.rate) if item.rate else \"\" }}</b></td>\n                            <td style=\"text-align: center; width: 10%;\"><b>{{ \"{:,.0f}\".format(item.amount|round|int) if item.amount else \"\" }}</b></td>\n                            <td style=\"text-align: center;\"><b>{% if item.get('custom_tax_rate') %}{{ item.custom_tax_rate }}%{% endif %}</b></td>\n                            <td style=\"text-align: center;\"><b>{% if item.get('custom_tax_amount') %}{{ \"{:,.0f}\".format(item.custom_tax_amount|round|int) }}{% endif %}</b></td>\n                            \n                            {% set total = (item.amount or 0) + (item.get('custom_tax_amount') or 0) %}\n                            <td style=\"text-align: center;\"><b>{{ \"{:,.0f}\".format(total|round|int) if total else \"\" }}</b></td>\n                        </tr>\n                        {% endfor %}\n                        \n                        {%- for row in range(8-count.total) -%}\n                        <tr style=\"font-size: 11px\">\n                            <td style=\"text-align: center; width: 10%;border-bottom:hidden\"></td>\n                            <td style=\"text-align: center; width: 30%;border-bottom:hidden\"></td>\n                            <td style=\"text-align: center;border-bottom:hidden\"></td>\n                            <td style=\"text-align: center; width: 10%;border-bottom:hidden\"></td>\n                            <td style=\"text-align: center;border-bottom:hidden\"></td>\n                            <td style=\"text-align: center;border-bottom:hidden\"></td>\n                            <td style=\"text-align: center;border-bottom:hidden\"></td>\n                        </tr>\n                        {%- endfor -%}\n                        \n                        <tr></tr>\n                        <tr>\n                            <td colspan=\"2\" style=\"text-align:left;font-family:Serif;border-right:hidden;font-size:11px\">{{ doc.in_words or \"\" }}</td>\n                            <td style=\"border-right:hidden\" ></td>\n                            <td style=\"border-right:hidden\" ></td>\n                            <td ></td>\n                            <td style=\"text-align:center;width: 15%;\"><b>{{ \"{:,.0f}\".format(doc.total_taxes_and_charges|round|int) if doc.total_taxes_and_charges else \"\" }}</b></td>\n                            <td style=\"text-align:center;\"><b>{{ \"{:,.0f}\".format(doc.grand_total|round|int) if doc.grand_total else \"\" }}</b></td>\n                        </tr>\n                    </tbody>\n                </table>\n            </td>\n        </tr>\n        <tr>\n            <td>\n                <table width=\"100%\">\n                    <tr>\n                        <td>\n                            <p>*Income Tax is required to be withheld under section 153 of the Income Tax Ordinance 2001 at 4% in case of services and 5% in case of goods. Please deposit the tax withheld and send us prescribed certificate of deduction at earliest</p>\n                        </td>\n                    </tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n</body>\n</html>\n\n{% if doc.get('custom_fbr_invoice_number') and doc.get('custom_fbr_datetime') and doc.get('custom_fbr_status') %}\n{% set qr_payload = doc.custom_fbr_invoice_number %}\n<table style=\"width:100%; text-align:center; border-collapse:collapse;\">\n    <tr>\n        <td style=\"width:50%; vertical-align:top;\">\n            <img src=\"/assets/fbr_e_invoicing/images/DigitalInvoicingSystemLogo.png\" style=\"width:120px; height:auto;\">\n        </td>\n        <td style=\"width:50%; vertical-align:top;\">\n            <div style=\"margin-top:10px;\">\n                {{ web_block('E-Invoice QR Code', values={'qr_text': qr_payload}) }}\n            </div>\n        </td>\n    </tr>\n    <tr>\n        <td colspan=\"2\" style=\"width:50%; text-align:center;\">\n            <div style=\"margin-top:10px;\">\n                <p><strong>FBR Invoice No:</strong> {{ doc.custom_fbr_invoice_number or \"\" }}</p>\n            </div>\n        </td>\n    </tr>\n</table>\n{% endif %}",
